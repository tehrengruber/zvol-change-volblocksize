FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
        qemu-system-x86 qemu-utils xorriso curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY . /harness

# Base cloud image is cached here; mount a volume to persist it across runs.
ENV CACHE_DIR=/cache
VOLUME /cache

ENTRYPOINT ["/harness/entrypoint.sh"]
