#cloud-config
# NoCloud seed: install ZFS userland + a C++ toolchain, mount the repo (ro) and an
# output dir (rw) over 9p, build with CMake and run the suite with CTest, and
# record the result. Every step is checked; an unexpected failure aborts with a
# distinct exit code instead of being ignored.
write_files:
  - path: /root/run-tests.sh
    permissions: '0755'
    content: |
      #!/bin/bash
      # cloud-init's runcmd PATH lacks sbin, where zfs/zpool live.
      export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
      export DEBIAN_FRONTEND=noninteractive
      exec > /dev/console 2>&1
      set -x

      # Distinct exit codes so a failure is never mistaken for a test result.
      fail() { echo "ZVOL_CVB_RESULT:$1"; echo "FATAL: $2"; sync; sleep 3; systemctl poweroff -i; exit "$1"; }

      mkdir -p /mnt/repo /mnt/out
      mount -t 9p -o trans=virtio,version=9p2000.L out /mnt/out \
          || fail 91 "output 9p mount failed"
      mount -t 9p -o trans=virtio,version=9p2000.L,ro repo /mnt/repo \
          || fail 92 "repo 9p mount failed"

      modprobe zfs || fail 93 "modprobe zfs failed"

      # esm-cache.service holds the apt lock at boot; wait for it via Lock::Timeout.
      apt-get -o DPkg::Lock::Timeout=600 update || fail 94 "apt-get update failed"
      apt-get -o DPkg::Lock::Timeout=600 install -y --no-install-recommends \
          build-essential cmake zfsutils-linux || fail 94 "installing build deps failed"
      command -v zpool >/dev/null || fail 94 "zpool missing after install"

      # Out-of-source build (the repo is mounted read-only).
      cmake -S /mnt/repo -B /root/build -DCMAKE_BUILD_TYPE=Release \
          || fail 95 "cmake configure failed"
      cmake --build /root/build -j"$(nproc)" || fail 95 "build failed"

      ctest --test-dir /root/build --output-on-failure 2>&1 | tee /mnt/out/ctest.log
      RC=${PIPESTATUS[0]}
      echo "ZVOL_CVB_RESULT:$RC"
      echo "$RC" > /mnt/out/result
      sync
      sleep 3
      systemctl poweroff -i
runcmd:
  - [ bash, /root/run-tests.sh ]
